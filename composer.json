{
    "name": "obelaw/ium-pos",
    "description": "POS Module for Obelawium ERP",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Obelaw\\Ium\\Pos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obelaw\\Ium\\Pos\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "obelaw/ium": "dev-main"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\Ium\\Pos\\Providers\\ObelawPOSTerviceProvider"
            ]
        }
    }
}